# Kopieren nach inspo/.env und ausfuellen
ANTHROPIC_API_KEY=sk-ant-...
INSPO_TG_TOKEN=123456:ABC...          # von @BotFather
INSPO_TG_CHATS=-1001234567890,12345678  # Inspo-Gruppe + eure Privatchats (per /id herausfinden)
# INSPO_GRUPPE_LEISE=1                  # in der Gruppe nur Reaktionen, keine Textantworten
# INSPO_SCHWELLE=6                      # ab welcher Relevanz (0-10) der volle Breakdown laeuft
# INSPO_MODELL=claude-opus-5-5
# INSPO_MODELL_TRIAGE=claude-opus-5-5   # fuer den Vorfilter, z.B. claude-haiku-5-5 fuer weniger Kosten
# INSPO_COOKIES=/pfad/zu/cookies.txt    # Instagram-Login-Cookies fuer yt-dlp
# INSPO_DATEN=/srv/inspo                # Ablage fuer DB, Medien, Bibliothek
